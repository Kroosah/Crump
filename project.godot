; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CRUMP"
config/description="First person psychological horror — Kroosah Interactive"
config/version="0.0.16"
run/main_scene="res://game/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://game/audio_bus_layout.tres"

[autoload]

EventBus="*res://game/autoload/event_bus.gd"
GameState="*res://game/autoload/game_state.gd"
AudioDirector="*res://game/autoload/audio_director.gd"
SettingsManager="*res://game/autoload/settings_manager.gd"
SaveManager="*res://game/autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

